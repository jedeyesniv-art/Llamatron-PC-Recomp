# CRT+ : the CRT look from "Llamasoft on the ST". Every setting is in the shader parameters.
shaders = 7

shader0 = shaders/linearize.slang
alias0 = GlowL0
filter_linear0 = true
wrap_mode0 = clamp_to_edge
scale_type0 = source
scale0 = 1.0
float_framebuffer0 = true

