// CRT++ parameters (crt-plus-plus.slangp only).
#pragma parameter LL_PSY_TRAILS "CRT++: trail strength" 0.9 0.0 2.0 0.05
#pragma parameter LL_PSY_LENGTH "CRT++: trail length (seconds to fade to half)" 0.4 0.0 2.0 0.01
#pragma parameter LL_PSY_ZOOM "CRT++: trail zoom (+ outwards, - inwards)" 0.25 -2.0 2.0 0.05
#pragma parameter LL_PSY_TWIST "CRT++: trail twist (swirl round the centre)" 0.0 -2.0 2.0 0.05
#pragma parameter LL_PSY_CENTRE_X "CRT++: zoom / twist centre, across" 0.5 0.0 1.0 0.05
#pragma parameter LL_PSY_CENTRE_Y "CRT++: zoom / twist centre, down" 0.5 0.0 1.0 0.05
#pragma parameter LL_PSY_HUE "CRT++: trail colour (hue)" 0.66 0.0 1.0 0.02
#pragma parameter LL_PSY_TINT "CRT++: how quickly trails take that colour" 0.3 0.0 1.0 0.05
#pragma parameter LL_PSY_CYCLE "CRT++: colour cycle (rainbow turns a second)" 0.0 0.0 3.0 0.05
#pragma parameter LL_PSY_THRESHOLD "CRT++: trail threshold (how bright things must be)" 0.1 0.0 1.0 0.05
#pragma parameter LL_PSY_GAIN "CRT++: trail feed (brightness entering the trails)" 1.0 0.0 3.0 0.1
#pragma parameter LL_PSY_KEEP "CRT++: keep colours (trails stay off the picture)" 1.0 0.0 1.0 0.05
#pragma parameter LL_PSY_BLEED "CRT++: colour bleed (composite TV smear)" 0.5 0.0 3.0 0.1
#pragma parameter LL_PSY_GLOW "CRT++: glow boost (x the halation)" 4.0 1.0 15.0 0.5
#pragma parameter LL_PSY_SATURATION "CRT++: saturation boost (x the saturation)" 1.3 0.5 2.5 0.05
#pragma parameter LL_PSY_FPS "CRT++: frame rate when the host doesn't say (ShaderGlass)" 60.0 10.0 240.0 1.0
