# CRT++ : CRT+ with Jeff Minter-style feedback trails, colour bleed and a boosted glow, from "Llamasoft on the ST".
# Every setting is in the shader parameters. The trails run at 4x the source (scale0); for big sources (640 x 480
# and up) scale0 = 2.0 is lighter - then set scale2 to 0.5 to match (it must bring the picture back to the
# source's size).
shaders = 9

shader0 = shaders/psy-trail.slang
alias0 = Trail
filter_linear0 = true
wrap_mode0 = clamp_to_edge
scale_type0 = source
scale0 = 4.0
float_framebuffer0 = true

shader1 = shaders/psy-mix.slang
alias1 = PsyOut
filter_linear1 = true
wrap_mode1 = clamp_to_edge
scale_type1 = source
scale1 = 1.0
float_framebuffer1 = true

shader2 = shaders/linearize.slang
alias2 = GlowL0
filter_linear2 = true
wrap_mode2 = clamp_to_edge
scale_type2 = source
scale2 = 0.25
float_framebuffer2 = true

shader3 = shaders/glow-down.slang
alias3 = GlowL1
filter_linear3 = true
wrap_mode3 = clamp_to_edge
scale_type3 = source
scale3 = 0.5
float_framebuffer3 = true

shader4 = shaders/glow-down.slang
alias4 = GlowL2
filter_linear4 = true
wrap_mode4 = clamp_to_edge
scale_type4 = source
scale4 = 0.5
float_framebuffer4 = true

shader5 = shaders/glow-down.slang
alias5 = GlowL3
filter_linear5 = true
wrap_mode5 = clamp_to_edge
scale_type5 = source
scale5 = 0.5
float_framebuffer5 = true

shader6 = shaders/glow-down.slang
alias6 = GlowL4
filter_linear6 = true
wrap_mode6 = clamp_to_edge
scale_type6 = source
scale6 = 0.5
float_framebuffer6 = true

shader7 = shaders/glow-down.slang
alias7 = GlowL5
filter_linear7 = true
wrap_mode7 = clamp_to_edge
scale_type7 = source
scale7 = 0.5
float_framebuffer7 = true

shader8 = shaders/crt-plus-plus.slang
filter_linear8 = true
wrap_mode8 = clamp_to_edge
scale_type8 = viewport
scale8 = 1.0
